# ====================================
# PC Store — Environment Configuration Template
# ====================================

# ── Database ────────────────────────
DB_HOST=localhost
DB_NAME=db_ban_linh_kien
DB_USER=root
DB_PASS=

# ── Debug / Dev ────────────────────
# Bật true khi phát triển (hiện lỗi PHP), tắt false khi deploy
APP_DEBUG=true

# ── SMTP / Email (Tùy chọn) ─────────
# SMTP_USE=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_EMAIL=noreply@banlinhkien.vn
# SMTP_FROM_NAME=Ban Linh Kiện

# ── VNPay (Tùy chọn) ────────────────
# VNPAY_TMN_CODE=YOUR_TMN_CODE
# VNPAY_HASH_SECRET=YOUR_HASH_SECRET
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=http://localhost:8082/Ban_linh_kien/vnpay_return.php

# ── Chuyển khoản ngân hàng (VietQR) ─
BANK_ID=mb
BANK_ACCOUNT=2312200566656
BANK_ACCOUNT_NAME=HOANG QUANG TUNG
