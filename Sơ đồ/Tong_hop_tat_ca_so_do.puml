' ----------------------------------------------------------------------
' FILE: 20_ClassDiagram_TangModel.puml
' ----------------------------------------------------------------------
@startuml
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 5
skinparam classFontSize 12
skinparam classFontName "Segoe UI, Arial"
skinparam classHeaderBackgroundColor #2563EB
skinparam classHeaderFontColor #FFFFFF
skinparam classBorderColor #1D4ED8
skinparam classBackgroundColor #F8FAFC
left to right direction

title SƠ ĐỒ CLASS DIAGRAM - TẦNG MODEL & CORE DATABASE (PSR-4)

package "App\\Core" {
  class Database <<Singleton>> {
    - {static} Database instance
    - PDO pdo
    - __construct()
    + {static} getInstance() : PDO
    + {static} beginTransaction() : bool
    + {static} commit() : bool
    + {static} rollBack() : bool
  }
}

package "App\\Models" {
  class UserModel {
    - PDO db
    + __construct(PDO db)
    + getUserById(int id) : array
    + getUserByEmail(string email) : array
    + getUserByUsername(string username) : array
    + createUser(array data) : int
    + updateUser(int id, array data) : bool
    + verifyPassword(string pass, string hash) : bool
  }

  class ProductModel {
    - PDO db
    + __construct(PDO db)
    + getProductById(int id) : array
    + getProductsByCategory(int catId, int limit, int offset) : array
    + searchProducts(string keyword, array filters) : array
    + decrementQuantity(int id, int qty) : bool
    + incrementQuantity(int id, int qty) : bool
    + getProductSpecs(int productId) : array
  }

  class OrderModel {
    - PDO db
    + __construct(PDO db)
    + createOrder(array orderData, array cartItems) : int
    + getOrderById(int id) : array
    + getOrderByAccessToken(string token) : array
    + getOrdersByUser(int userId) : array
    + updateOrderStatus(int id, string status, string note) : bool
    + updatePaymentStatus(int id, string payStatus, string txn) : bool
  }

  class VoucherModel {
    - PDO db
    + __construct(PDO db)
    + getVoucherByCode(string code) : array
    + validateVoucher(string code, float total, int userId) : array
    + recordUsage(int voucherId, int userId, int orderId, float discount) : bool
  }

  class AddressModel {
    - PDO db
    + __construct(PDO db)
    + getAddressesByUser(int userId) : array
    + addAddress(array data) : int
    + setDefaultAddress(int userId, int addressId) : bool
  }

  class ProductCommentModel {
    - PDO db
    + __construct(PDO db)
    + getByProduct(int productId) : array
    + addComment(array data) : int
    + approveComment(int commentId) : bool
  }
}

Database <.. UserModel : uses
Database <.. ProductModel : uses
Database <.. OrderModel : uses
Database <.. VoucherModel : uses
Database <.. AddressModel : uses
Database <.. ProductCommentModel : uses

OrderModel ..> ProductModel : modifies stock
OrderModel ..> VoucherModel : verifies coupon
UserModel ..> AddressModel : manages
ProductModel ..> ProductCommentModel : reviews
@enduml

' ----------------------------------------------------------------------
' FILE: 21_Component_Middleware_Pipeline_Admin.puml
' ----------------------------------------------------------------------
@startuml
skinparam shadowing false
skinparam roundcorner 5
skinparam componentStyle rectangle
skinparam componentFontSize 12
skinparam componentFontName "Segoe UI, Arial"
left to right direction

title SƠ ĐỒ COMPONENT - MIDDLEWARE PIPELINE (ADMIN SUB-SYSTEM)

actor "Admin Browser\n(Request)" as Browser

package "Admin Application Pipeline" {
  component "MiddlewareRunner\n(Pipeline Manager)" as Runner

  component "1. AuthMiddleware\n(Kiểm tra Session & Khóa)" as AuthMW
  component "2. CsrfMiddleware\n(Xác thực Token POST/PUT)" as CsrfMW
  component "3. PermissionMiddleware\n(Kiểm tra quyền RBAC)" as PermMW
  component "4. AuditMiddleware\n(Ghi nhận thay đổi)" as AuditMW

  component "Admin Controller Action\n(VD: ProductController::edit)" as Controller
  component "View Renderer / JSON\n(Phản hồi kết quả)" as Response
}

database "MySQL Database\n(audit_logs & roles)" as DB

Browser --> Runner : HTTP Request (/admin/?module=products&action=edit)
Runner --> AuthMW : Bước 1
AuthMW --> CsrfMW : Bước 2 (Nếu hợp lệ)
CsrfMW --> PermMW : Bước 3 (Nếu CSRF khớp)
PermMW --> AuditMW : Bước 4 (Nếu có quyền)
AuditMW --> Controller : Bước 5 (Được phép thực thi)

AuditMW ..> DB : Ghi log IP, OldData, NewData
Controller --> Response : Trả dữ liệu giao diện
Response --> Browser : HTTP 200 Response
@enduml

' ----------------------------------------------------------------------
' FILE: 22_Sequence_DangNhap_SessionTimeout.puml
' ----------------------------------------------------------------------
@startuml
autonumber
skinparam shadowing false
skinparam roundcorner 5
skinparam sequenceMessageAlign center

title SƠ ĐỒ SEQUENCE - ĐĂNG NHẬP & QUẢN LÝ PHIÊN (SESSION TIMEOUT 8H)

actor "Người dùng" as User
participant "Trình duyệt Web" as Browser
participant "session_check.php" as SessCheck
participant "UserController" as Ctrl
database "MySQL Database\n(users)" as DB
participant "PHP Session Store\n($_SESSION)" as Sess

== Giai đoạn 1: Đăng nhập an toàn & Khởi tạo phiên ==
User -> Browser: Nhập username, password & Bấm Đăng nhập
Browser -> Ctrl: POST /taikhoan.php?action=login (CSRF Token)
activate Ctrl

Ctrl -> DB: SELECT * FROM users WHERE username = ?
activate DB
DB --> Ctrl: Bản ghi user (password hash, is_blocked)
deactivate DB

Ctrl -> Ctrl: password_verify(password, hash)

alt Mật khẩu chính xác VÀ is_blocked == 0
    Ctrl -> Sess: session_regenerate_id(true) [Chống Session Fixation]
    Ctrl -> Sess: $_SESSION['user_id'] = $user['id']
    Ctrl -> Sess: $_SESSION['last_activity'] = time()
    Ctrl --> Browser: Set-Cookie: PHPSESSID (HttpOnly, SameSite=Lax, 28800s)
    Ctrl --> Browser: HTTP 302 Redirect về Trang chủ / Dashboard
else Sai thông tin hoặc tài khoản bị khóa
    Ctrl --> Browser: Flash Message thông báo lỗi đăng nhập
end
deactivate Ctrl

== Giai đoạn 2: Tự động gia hạn hoặc Đăng xuất sau 8h không hoạt động ==
User -> Browser: Nhấp chuột điều hướng sang trang khác (VD: giohang.php)
Browser -> SessCheck: GET /giohang.php (Kèm Cookie PHPSESSID)
activate SessCheck

alt $_SESSION['user_id'] tồn tại
    SessCheck -> SessCheck: $idle = time() - $_SESSION['last_activity']

    alt $idle > 28800 giây (Quá 8 tiếng không hoạt động)
        SessCheck -> Sess: $_SESSION = []; session_destroy();
        SessCheck -> Sess: session_start(); $_SESSION['timeout_msg'] = 'Phiên hết hạn...'
        SessCheck --> Browser: HTTP 302 Redirect sang /taikhoan.php?timeout=1
        Browser --> User: Chuyển về màn hình đăng nhập kèm cảnh báo hết hạn
    else $idle <= 28800 giây (Phiên còn hiệu lực)
        SessCheck -> Sess: $_SESSION['last_activity'] = time() (Gia hạn thời gian)
        SessCheck --> Browser: Tiếp tục nạp nội dung trang yêu cầu
    end
else Khách vãng lai chưa đăng nhập
    SessCheck --> Browser: Tiếp tục xử lý chế độ khách
end
deactivate SessCheck
@enduml

