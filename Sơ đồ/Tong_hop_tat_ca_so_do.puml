' ----------------------------------------------------------------------
' FILE: 04_Sequence_Them_BuildPC_VaoGioHang.puml
' ----------------------------------------------------------------------
@startuml
autonumber
skinparam shadowing false
skinparam roundcorner 5
skinparam sequenceMessageAlign center
skinparam sequenceBoxBorderColor #CBD5E1

title SƠ ĐỒ SEQUENCE - THÊM CẤU HÌNH BUILD PC VÀO GIỎ HÀNG

actor "Khách hàng" as Customer
participant "Giao diện Build PC\n(buildpc.php)" as UI
participant "BuildPcController" as Ctrl
participant "ProductModel" as Model
database "MySQL Database\n(products)" as DB
participant "Session\n($_SESSION['cart'])" as Sess

Customer -> UI: Chọn CPU, Mainboard, RAM, VGA, PSU, Case
note over UI: JavaScript kiểm tra tương thích Socket & Công suất nguồn (TDP)
Customer -> UI: Bấm "Thêm tất cả vào giỏ hàng"
UI -> Ctrl: POST /buildpc.php?action=add_to_cart (danh sách product_id[])
activate Ctrl

loop Duyệt từng linh kiện trong bộ máy ráp
    Ctrl -> Model: getProductById(id)
    activate Model
    Model -> DB: SELECT * FROM products WHERE id=? AND is_active=1
    DB --> Model: Trả về giá, số lượng tồn kho
    deactivate Model
end

alt Có linh kiện hết hàng (quantity <= 0)
    Ctrl --> UI: Redirect kèm Flash Error ("Linh kiện X đã hết hàng!")
    UI --> Customer: Hiển thị cảnh báo màu đỏ
else Tất cả linh kiện đều còn hàng
    Ctrl -> Sess: Merge linh kiện vào $_SESSION['cart']
    Ctrl -> DB: Đồng bộ dữ liệu giỏ vào bảng abandoned_carts
    Ctrl --> UI: Header("Location: giohang.php")
    deactivate Ctrl
    UI --> Customer: Chuyển hướng đến giỏ hàng kèm thông báo thành công
end
@enduml

' ----------------------------------------------------------------------
' FILE: 05_Sequence_DatHang_ThanhToan_VNPay.puml
' ----------------------------------------------------------------------
@startuml
autonumber
skinparam shadowing false
skinparam roundcorner 5
skinparam sequenceMessageAlign center

title SƠ ĐỒ SEQUENCE - ĐẶT HÀNG & THANH TOÁN VNPAY

actor "Khách hàng" as Customer
participant "Giao diện Checkout\n(thanhtoan.php)" as UI
participant "CheckoutController" as Ctrl
participant "VNPayHelper" as VNHelper
database "MySQL Database" as DB
participant "Cổng VNPay Gateway" as VNPay
participant "Trang Return\n(thanhtoan_success.php)" as Success
participant "Email Worker" as Worker

Customer -> UI: Điền thông tin giao hàng & chọn phương thức VNPay
UI -> Ctrl: POST /thanhtoan.php (CSRF Token, họ tên, địa chỉ, voucher)
activate Ctrl

note over Ctrl: Kiểm tra CsrfHelper::verify()
Ctrl -> DB: SELECT products FOR UPDATE (Khóa dòng kiểm tra tồn kho)
Ctrl -> DB: Kiểm tra Voucher & Điểm tích lũy

group Database Transaction Tạo đơn hàng
    Ctrl -> DB: INSERT INTO orders (total, status='pending', payment_status='unpaid', access_token)
    Ctrl -> DB: INSERT INTO order_items (order_id, product_id, price, quantity)
    Ctrl -> DB: UPDATE products SET quantity = quantity - ? (Trừ kho)
    Ctrl -> DB: INSERT INTO payment_transactions (gateway='vnpay', status='pending')
end

Ctrl -> VNHelper: createPaymentUrl($orderId, $totalAmount)
note over VNHelper: Tạo TxnRef: "{orderId}_{timestamp}"\nBăm chữ ký số HMAC-SHA512
VNHelper --> Ctrl: Trả về URL cổng thanh toán VNPay
Ctrl --> UI: HTTP 302 Redirect sang VNPAY_URL
deactivate Ctrl

UI -> VNPay: Điều hướng tới cổng thanh toán VNPay
activate VNPay
Customer -> VNPay: Quét mã VietQR / Nhập thông tin thẻ ATM & OTP
VNPay -> VNPay: Xử lý giao dịch trừ tiền
VNPay --> UI: HTTP 302 Redirect về thanhtoan_success.php (kèm vnp_SecureHash)
deactivate VNPay

UI -> Success: GET callback (vnp_ResponseCode, vnp_TxnRef, vnp_SecureHash)
activate Success
Success -> VNHelper: validateSignature($_GET)

alt Chữ ký hợp lệ VÀ vnp_ResponseCode == '00'
    Success -> DB: UPDATE payment_transactions SET status='success', paid_at=NOW()
    Success -> DB: UPDATE orders SET payment_status='paid', status='processing'
    Success -> DB: INSERT INTO order_status_history (from_status='pending', to_status='processing')
    Success -> DB: INSERT INTO email_queue (to_email, subject, body_html)
    Success -> DB: INSERT INTO loyalty_points (points, type='earn')
    Success -> Worker: Kích hoạt gửi email hóa đơn điện tử
    Success -> Success: unset($_SESSION['cart'])
    Success --> Customer: Hiển thị giao diện Đặt hàng thành công & Mã tra cứu
else Giao dịch thất bại / Khách hủy
    Success -> DB: UPDATE payment_transactions SET status='failed'
    Success --> Customer: Báo lỗi giao dịch và cung cấp nút Thanh toán lại
end
deactivate Success
@enduml

' ----------------------------------------------------------------------
' FILE: 06_Sequence_Chatbot_AI_TuVan.puml
' ----------------------------------------------------------------------
@startuml
autonumber
skinparam shadowing false
skinparam roundcorner 5
skinparam sequenceMessageAlign center

title SƠ ĐỒ SEQUENCE - CHATBOT AI TƯ VẤN CẤU HÌNH (GROQ LLAMA 3.3)

actor "Khách hàng" as Customer
participant "Chatbot Widget UI\n(chatbot_buildpc.js)" as UI
participant "Backend Endpoint\n(chatbot_buildpc.php)" as Server
database "MySQL Database\n(products + specs)" as DB
participant "Groq Cloud AI API\n(LLaMA 3.3 70B)" as Groq

Customer -> UI: Nhập yêu cầu: "Tư vấn case máy tính 18 triệu đồ họa"
UI -> Server: POST /chatbot_buildpc.php (JSON: message, history[])
activate Server

Server -> DB: getProductContext() - Lấy linh kiện còn hàng (quantity > 0)
activate DB
DB --> Server: Trả về danh sách CPU, Mainboard kèm Socket, RAM, VGA và Giá
deactivate DB

note over Server
  Đóng gói Prompt:
  1. System Role: Chuyên gia ráp PC Bán Linh Kiện
  2. Bơm ngữ cảnh (Context Injection): Danh sách sản phẩm thực tế
  3. Ràng buộc: Chỉ đề xuất linh kiện khớp Socket và đúng định dạng [ID:xxx]
end note

Server -> Groq: POST /openai/v1/chat/completions (GROQ_API_KEY, Model: llama-3.3-70b-versatile)
activate Groq
note over Groq: LLaMA 3.3 suy luận kiểm tra tương thích phần cứng & cân đối ngân sách
Groq --> Server: JSON phản hồi đoạn tư vấn kèm các tag [ID:105], [ID:204],...
deactivate Groq

note over Server: Dùng Regex trích xuất danh sách ID sản phẩm: /\[ID:(\d+)\]/

Server -> DB: SELECT id, name, price, image FROM products WHERE id IN (...)
activate DB
DB --> Server: Dữ liệu hình ảnh, giá bán thực tế của sản phẩm
deactivate DB

Server --> UI: HTTP 200 JSON {reply: "...", suggestions: [{id, name, price, image}, ...]}
deactivate Server

UI --> Customer: Hiển thị lời khuyên chuyên gia + Các card sản phẩm tương tác kèm nút "Chọn vào dàn PC"
@enduml

' ----------------------------------------------------------------------
' FILE: 07_Activity_QuyTrinh_XuLy_DonHang.puml
' ----------------------------------------------------------------------
@startuml
skinparam shadowing false
skinparam roundcorner 5
skinparam conditionStyle inside
skinparam ActivityFontSize 12
skinparam ActivityFontName "Segoe UI, Arial"

title SƠ ĐỒ ACTIVITY - QUY TRÌNH XỬ LÝ ĐƠN HÀNG (END-TO-END)

|#E0F2FE|Khách hàng|
start
:Duyệt giỏ hàng & Bấm "Thanh toán";
:Điền thông tin nhận hàng & Áp dụng Voucher;
if (Chọn hình thức thanh toán?) then (VNPay / Trực tuyến)
  |#FEF3C7|Cổng thanh toán & Hệ thống|
  :Chuyển hướng sang VNPay Gateway;
  :Khách quét mã QR / Nhập OTP;
  if (Thanh toán thành công?) then (Có)
    :Cập nhật payment_status = 'paid';
    :Tạo đơn hàng trạng thái 'processing';
  else (Thất bại)
    :Báo lỗi thanh toán & Cho phép chọn lại;
    detach
  endif
else (COD - Tiền mặt khi nhận)
  |#FEF3C7|Cổng thanh toán & Hệ thống|
  :Tạo đơn hàng trạng thái 'pending';
  |#FCE7F3|Bộ phận Bán hàng / Admin|
  :Gọi điện thoại xác nhận đơn;
  if (Xác nhận hợp lệ?) then (Có)
    :Chuyển đơn sang 'processing';
  else (Khách hủy / Không liên lạc được)
    :Cập nhật trạng thái 'cancelled';
    :Hoàn trả số lượng tồn kho;
    stop
  endif
endif

|#DCFCE7|Bộ phận Kho hàng|
:In phiếu xuất kho & Đóng gói linh kiện;
:Quét & Gán mã Serial Number từng linh kiện (status = 'sold');
:Tạo vận đơn với Đơn vị vận chuyển (sinh tracking_code);
:Cập nhật đơn sang 'shipped' & Gửi email thông báo vận đơn;

|#EDE9FE|Đơn vị vận chuyển (Logistics)|
:Shipper giao hàng tới địa chỉ nhận;
if (Khách nhận hàng thành công?) then (Có)
  :Ký nhận & Thu tiền (nếu COD);
  |#FEF3C7|Cổng thanh toán & Hệ thống|
  :Cập nhật đơn sang 'completed' (payment_status = 'paid');
  :Cộng điểm tích lũy thành viên (Loyalty Points);
  |#E0F2FE|Khách hàng|
  :Mở quyền đánh giá sản phẩm & Quyền yêu cầu đổi trả (trong 7 ngày);
  stop
else (Giao thất bại quá 3 lần / Khách boom)
  |#DCFCE7|Bộ phận Kho hàng|
  :Chuyển hoàn kiện hàng về kho;
  :Nhập lại kho & Cập nhật đơn sang 'cancelled';
  stop
endif
@enduml

' ----------------------------------------------------------------------
' FILE: 08_State_VongDoi_DonHang.puml
' ----------------------------------------------------------------------
@startuml
skinparam shadowing false
skinparam roundcorner 5
skinparam stateFontSize 12
skinparam stateFontName "Segoe UI, Arial"

title SƠ ĐỒ STATE - VÒNG ĐỜI ĐƠN HÀNG (ORDER LIFECYCLE)

[*] --> Pending : Khách bấm "Đặt hàng"

state Pending {
  state "Chờ thanh toán VNPay" as Unpaid
  state "Chờ gọi xác nhận COD" as AwaitingConfirm
  [*] --> Unpaid : Chọn cổng VNPay
  [*] --> AwaitingConfirm : Chọn COD
  Unpaid --> AwaitingConfirm : Thanh toán thành công (00)
}

Pending --> Processing : Admin xác nhận đơn / Đã thanh toán
Pending --> Cancelled : Quá 24h chưa thanh toán / Khách hủy

state Processing {
  state "Kiểm tra linh kiện" as Checking
  state "Gán Serial Number" as PickingSerial
  state "Đóng gói niêm phong" as Packing
  [*] --> Checking
  Checking --> PickingSerial
  PickingSerial --> Packing
}

Processing --> Shipped : Đã bàn giao ĐVVC (sinh tracking_code)
Processing --> Cancelled : Hết linh kiện kho / Sự cố đơn

state Shipped {
  state "Đang luân chuyển bưu cục" as InTransit
  state "Shipper đang phát hàng" as OutForDelivery
  [*] --> InTransit
  InTransit --> OutForDelivery
}

Shipped --> Completed : Khách ký nhận thành công & Thanh toán
Shipped --> Cancelled : Giao hàng thất bại / Khách boom hàng

state Completed {
  state "Kích hoạt bảo hành điện tử" as WarrantyActive
  state "Yêu cầu Đổi/Trả (<= 7 ngày)" as ReturnRequested
  [*] --> WarrantyActive
  WarrantyActive --> ReturnRequested : Gửi đơn khiếu nại
}

ReturnRequested --> Refunded : Admin duyệt hoàn tiền
ReturnRequested --> Completed : Đổi linh kiện mới / Bác bỏ khiếu nại

Completed --> [*]
Cancelled --> [*]
Refunded --> [*]
@enduml

