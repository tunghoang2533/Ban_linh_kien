' ----------------------------------------------------------------------
' FILE: 13_Deployment_TrienKhai_HeThong.puml
' ----------------------------------------------------------------------
@startuml
skinparam shadowing false
skinparam roundcorner 5
skinparam nodeFontSize 12
skinparam nodeFontName "Segoe UI, Arial"

title SƠ ĐỒ DEPLOYMENT - MÔ HÌNH TRIỂN KHAI VẬT LÝ HỆ THỐNG

node "Client Devices (Thiết bị đầu cuối)" as Clients {
  artifact "Desktop Web Browser\n(Chrome, Edge, Firefox)" as Desktop
  artifact "Mobile Web / PWA\n(Safari, Chrome Mobile)" as Mobile
  artifact "Admin Station\n(Máy trạm Quản trị)" as AdminPC
}

node "Edge / Web Server (Laragon / Apache / Nginx)" as WebServer {
  component "Reverse Proxy & SSL (HTTPS:443)\nLet's Encrypt TLS" as SSL
  component "URL Rewriting Engine\n(.htaccess / Nginx router)" as Rewrite
  folder "Static Assets Directory\n(/public/css, js, uploads)" as StaticFiles
}

node "Application Server (PHP 8.1+ Pure MVC)" as AppServer {
  component "Core Router & Session Guard\n(session_check.php - 8h Timeout)" as Core
  component "Admin Middleware Pipeline\n(Auth, CSRF, Permission, Audit)" as Middleware
  component "Controllers & Domain Services\n(Checkout, BuildPC, Product, User)" as Controllers
  component "Data Access Models & PDO\n(Database.php Singleton)" as Models
}

node "Background Workers (CLI Scheduled Tasks)" as Workers {
  artifact "email_queue_worker.php\n(Gửi mail hóa đơn & Reset pass)" as MailWorker
  artifact "abandoned_cart_worker.php\n(Quét cứu giỏ hàng bỏ quên)" as CartWorker
}

node "Database Server (Private Network)" as DBServer {
  database "MySQL 8.0 Server\n(InnoDB Engine - UTF8mb4)" as MySQL
  folder "File System Storage\n(/uploads/products, /invoices)" as FileStorage
}

cloud "External Cloud Services (Dịch vụ bên thứ ba)" as CloudServices {
  component "VNPay Payment Gateway\n(HMAC-SHA512 API & IPN)" as VNPay
  component "Groq AI Cloud\n(LLaMA 3.3 70B REST API)" as Groq
  component "SMTP Mail Server\n(Google SMTP TLS Port 587)" as SMTP
}

Clients --> WebServer : HTTPS (Port 443)
WebServer --> AppServer : FastCGI / PHP-FPM (Port 9000)
AppServer --> DBServer : PDO Prepared Statements (Port 3306)
AppServer --> FileStorage : Ghi file Upload ảnh
Workers --> MySQL : Quét hàng đợi (Port 3306)
Workers --> SMTP : TLS Port 587
AppServer --> VNPay : Redirect & Webhook IPN
AppServer --> Groq : HTTPS POST cURL
@enduml

' ----------------------------------------------------------------------
' FILE: 14_Sequence_DoiTraHang.puml
' ----------------------------------------------------------------------
@startuml
autonumber
skinparam shadowing false
skinparam roundcorner 5
skinparam sequenceMessageAlign center

title SƠ ĐỒ SEQUENCE - QUY TRÌNH ĐỔI / TRẢ HÀNG & BẢO HÀNH

actor "Khách hàng" as Customer
participant "Giao diện Đổi trả\n(doitra.php)" as UI
participant "Return Handler" as Ctrl
database "MySQL Database" as DB
actor "Quản trị viên / Kỹ thuật" as Admin
actor "Thủ kho tiếp nhận" as WH
participant "Cổng VNPay / Ngân hàng" as Gateway

Customer -> UI: Chọn đơn 'completed', chọn linh kiện lỗi, nhập lý do & tải ảnh
UI -> Ctrl: POST /doitra.php (order_id, product_id, reason, images, CSRF)
activate Ctrl

Ctrl -> DB: SELECT created_at, status FROM orders WHERE id=?
note over Ctrl: Kiểm tra điều kiện chính sách (thời gian <= 7 ngày)
Ctrl -> DB: INSERT INTO return_requests (order_id, product_id, user_id, reason, images, status='pending')
Ctrl --> UI: Báo gửi yêu cầu thành công
deactivate Ctrl

Admin -> DB: Xem danh sách yêu cầu đổi trả (status='pending')
Admin -> Admin: Thẩm định hình ảnh / video bằng chứng lỗi

alt Từ chối (Lỗi do người dùng làm rơi vỡ, cháy nổ)
    Admin -> DB: UPDATE return_requests SET status='rejected', admin_note=?
    Admin -> Customer: Gửi Email giải thích nguyên nhân từ chối
else Chấp thuận đổi trả
    Admin -> DB: UPDATE return_requests SET status='approved'
    Admin -> Customer: Gửi hướng dẫn đóng gói gửi linh kiện về kho
    
    Customer -> WH: Gửi bưu kiện linh kiện lỗi về trung tâm bảo hành
    activate WH
    WH -> DB: SELECT * FROM serial_numbers WHERE serial_code=? AND sold_order_id=?
    note over WH: Đối soát tem niêm phong và mã Serial Number gốc

    alt Khách chọn Đổi linh kiện mới
        WH -> DB: UPDATE serial_numbers SET status='defective' WHERE serial_code=?
        WH -> DB: Xuất linh kiện mới: INSERT INTO warehouse_logs (type='out')
        WH -> Customer: Giao sản phẩm mới thay thế
    else Khách chọn Hoàn tiền giao dịch
        Admin -> Gateway: Gửi lệnh hoàn tiền qua API
        Gateway --> Admin: Xác nhận hoàn tiền thành công
        Admin -> DB: UPDATE orders SET payment_status='refunded'
        Admin -> DB: UPDATE return_requests SET status='completed', refund_amount=?
        Admin -> Customer: Gửi Email biên lai hoàn tiền
    end
    deactivate WH
end
@enduml

' ----------------------------------------------------------------------
' FILE: 15_Sequence_NhapKho_TaoSerialNumber.puml
' ----------------------------------------------------------------------
@startuml
autonumber
skinparam shadowing false
skinparam roundcorner 5
skinparam sequenceMessageAlign center

title SƠ ĐỒ SEQUENCE - NHẬP KHO & TẠO SERIAL NUMBER

actor "Nhân viên kho" as Staff
actor "Quản lý kho" as Manager
participant "Giao diện Nhập kho\n(receipt_form.php)" as UI
participant "WarehouseController" as Ctrl
database "MySQL Database" as DB
participant "Back in Stock Worker" as Worker

Staff -> UI: Chọn NCC, Kho nhập, danh sách linh kiện và số lượng
UI -> Ctrl: POST /admin/receipts/create (PO_id, supplier_id, warehouse_id, items[])
activate Ctrl

Ctrl -> DB: INSERT INTO warehouse_receipts (status='pending')
Ctrl -> DB: INSERT INTO warehouse_receipt_items
Ctrl --> UI: Tạo phiếu nhập thành công (Chờ kiểm đếm duyệt)
deactivate Ctrl

Manager -> UI: Mở phiếu nhập & Kiểm tra kiện hàng thực tế giao tới
Manager -> UI: Nhập/Quét Barcode mã Serial Number cho từng linh kiện
Manager -> UI: Bấm "Phê duyệt phiếu nhập kho"

UI -> Ctrl: POST /admin/receipts/approve (receipt_id, serial_list[])
activate Ctrl

group Database Transaction Nhập kho
    Ctrl -> DB: UPDATE warehouse_receipts SET status='approved' WHERE id=?
    
    loop Duyệt từng mã Serial Number được quét
        Ctrl -> DB: INSERT INTO serial_numbers (product_id, receipt_id, serial_code, status='in_stock', warranty_months)
    end

    loop Duyệt từng sản phẩm trong phiếu nhập
        Ctrl -> DB: SELECT quantity FROM products WHERE id=?
        Ctrl -> DB: UPDATE products SET quantity = quantity + ? WHERE id=?
        Ctrl -> DB: INSERT INTO warehouse_logs (product_id, type='in', quantity, before_qty, after_qty)
    end
end

Ctrl -> DB: SELECT email FROM back_in_stock_subscriptions WHERE product_id=? AND status='pending'
alt Có khách hàng đăng ký nhận thông báo có hàng
    Ctrl -> DB: INSERT INTO email_queue (to_email, subject, body_html)
    Ctrl -> DB: UPDATE back_in_stock_subscriptions SET status='notified', notified_at=NOW()
    Ctrl -> Worker: Kích hoạt gửi email tự động
end

Ctrl --> UI: Thông báo "Nhập kho thành công, đã cộng tồn kho và lưu mã Serial"
deactivate Ctrl
@enduml

' ----------------------------------------------------------------------
' FILE: 16_UseCase_KhachHang.puml
' ----------------------------------------------------------------------
@startuml
skinparam shadowing false
skinparam roundcorner 5
skinparam packageStyle rectangle
skinparam actorFontSize 12
skinparam usecaseFontSize 12
left to right direction

title SƠ ĐỒ USE CASE - PHÂN HỆ KHÁCH HÀNG

actor "Khách vãng lai\n(Chưa đăng nhập)" as Guest
actor "Khách hàng thành viên\n(Đã đăng nhập)" as Member

Member --|> Guest

rectangle "Hệ Thống Website Bán Linh Kiện" {
  package "Khám phá & Mua sắm" {
    usecase "UC01: Tìm kiếm & Lọc linh kiện\n(Danh mục, Hãng, Giá, Socket)" as UC_Search
    usecase "UC02: Xem chi tiết sản phẩm\n& Thông số kỹ thuật" as UC_Detail
    usecase "UC03: So sánh 2 sản phẩm" as UC_Compare
    usecase "UC04: Tự ráp máy (Build PC)\n& Check tương thích Socket" as UC_BuildPC
    usecase "UC05: Chatbot AI tư vấn cấu hình\ntheo ngân sách" as UC_ChatAI
  }

  package "Giỏ hàng & Đặt hàng" {
    usecase "UC06: Quản lý giỏ hàng" as UC_Cart
    usecase "UC07: Nhập mã Voucher giảm giá" as UC_Voucher
    usecase "UC08: Đặt hàng (Guest / Member)" as UC_Checkout
    usecase "UC09: Thanh toán trực tuyến VNPay" as UC_PayVNPay
    usecase "UC10: Thanh toán COD (Tiền mặt)" as UC_PayCOD
    usecase "UC11: Tra cứu vận đơn trực tuyến" as UC_Track
  }

  package "Tính năng Hội viên" {
    usecase "UC12: Quản lý hồ sơ & Sổ địa chỉ" as UC_Profile
    usecase "UC13: Quản lý danh sách Yêu thích" as UC_Wishlist
    usecase "UC14: Xem lịch sử & Chi tiết đơn hàng" as UC_History
    usecase "UC15: Tích lũy & Dùng điểm Loyalty" as UC_Loyalty
    usecase "UC16: Đánh giá sao & Bình luận linh kiện" as UC_Review
    usecase "UC17: Gửi yêu cầu Đổi/Trả hàng" as UC_Return
    usecase "UC18: Live Chat hỗ trợ khách hàng" as UC_LiveChat
  }
}

Guest --> UC_Search
Guest --> UC_Detail
Guest --> UC_Compare
Guest --> UC_BuildPC
Guest --> UC_ChatAI
Guest --> UC_Cart
Guest --> UC_Checkout
Guest --> UC_Track

UC_Checkout ..> UC_Cart : <<include>>
